          "task",
          "model_id",
          "global_step"
        ],
        "title": "CheckpointInfo"
      },
      "DatasetCreate": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Name"
          },
          "kind": {
            "type": "string",
            "enum": [
              "pretrain",
              "finetune"
            ],
            "title": "Kind",
            "default": "pretrain"
          },
          "rule_version": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Rule Version",
            "default": "unit-v1"
          },
          "records": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "maxItems": 100000,
            "minItems": 1,
            "title": "Records"
          },
          "base_dataset_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Base Dataset Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "records"
        ],
        "title": "DatasetCreate"
      },
      "DatasetInfo": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "kind": {
            "type": "string",
            "enum": [
              "pretrain",
              "finetune"
            ],
            "title": "Kind"
          },
          "rule_version": {
            "type": "string",
            "title": "Rule Version"
          },
          "hash": {
            "type": "string",
            "title": "Hash"
          },
          "count": {
            "type": "integer",
            "title": "Count"
          },
          "counts": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object",
            "title": "Counts"
          },
          "confirmed_count": {
            "type": "integer",
            "title": "Confirmed Count"
          },
          "characters": {
            "type": "integer",
            "title": "Characters"
          },
          "vocab_size": {
            "type": "integer",
            "title": "Vocab Size"
          },
          "warning": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
